rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ต้องล็อกอิน (Anonymous) ก่อนถึงอ่าน/เขียนได้
    match /events/{id} {
      allow read, write: if request.auth != null;
    }
    match /bookings/{id} {
      allow read, write: if request.auth != null;
    }
    // รูปผังล็อคของแต่ละงาน
    match /plans/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
